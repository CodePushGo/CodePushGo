{
  "version": 2,
  "periodCheckDelay": [
    { "id": "period.disabled.zero", "input": { "seconds": 0 }, "expect": { "normalizedSeconds": 0 } },
    { "id": "period.disabled.negative", "input": { "seconds": -1 }, "expect": { "normalizedSeconds": 0 } },
    { "id": "period.below-minimum.one-second", "input": { "seconds": 1 }, "expect": { "normalizedSeconds": 600 } },
    { "id": "period.below-minimum.just-under", "input": { "seconds": 599 }, "expect": { "normalizedSeconds": 600 } },
    { "id": "period.minimum", "input": { "seconds": 600 }, "expect": { "normalizedSeconds": 600 } },
    { "id": "period.above-minimum", "input": { "seconds": 3600 }, "expect": { "normalizedSeconds": 3600 } }
  ],
  "autoUpdateMode": [
    { "id": "auto-update.false", "input": { "mode": "false" }, "expect": { "mode": "off", "enabled": false, "checkOnStart": false } },
    { "id": "auto-update.true", "input": { "mode": "true" }, "expect": { "mode": "atBackground", "enabled": true, "checkOnStart": true } },
    { "id": "auto-update.at-background", "input": { "mode": "atBackground" }, "expect": { "mode": "atBackground", "enabled": true, "checkOnStart": true } },
    { "id": "auto-update.at-install-disabled", "input": { "mode": "atInstall" }, "expect": { "mode": "atBackground", "enabled": true, "checkOnStart": true } },
    { "id": "auto-update.on-launch-disabled", "input": { "mode": "onLaunch" }, "expect": { "mode": "atBackground", "enabled": true, "checkOnStart": true } },
    { "id": "auto-update.always-disabled", "input": { "mode": "always" }, "expect": { "mode": "atBackground", "enabled": true, "checkOnStart": true } },
    { "id": "auto-update.only-download-disabled", "input": { "mode": "onlyDownload" }, "expect": { "mode": "atBackground", "enabled": true, "checkOnStart": true } },
    { "id": "auto-update.invalid", "input": { "mode": "invalid" }, "expect": { "mode": "atBackground", "enabled": true, "checkOnStart": true } }
  ],
  "updateResponseKind": [
    { "id": "response-kind.up-to-date", "input": { "kind": "up_to_date" }, "expect": { "kind": "up_to_date" } },
    { "id": "response-kind.blocked", "input": { "kind": "blocked" }, "expect": { "kind": "blocked" } },
    { "id": "response-kind.failed", "input": { "kind": "failed" }, "expect": { "kind": "failed" } },
    { "id": "response-kind.missing", "input": { "kind": null }, "expect": { "kind": "failed" } },
    { "id": "response-kind.empty", "input": { "kind": "" }, "expect": { "kind": "failed" } },
    { "id": "response-kind.unknown", "input": { "kind": "update_available" }, "expect": { "kind": "failed" } }
  ]
}

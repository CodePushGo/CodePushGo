{
  "name": "codepushgo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/dashboard dev",
    "build": "bun run build:packages && bun run --cwd apps/dashboard build",
    "build:packages": "bun run --cwd packages/shared build && bun run --cwd packages/react-native-updater build && bun run --cwd packages/worker build && bun run --cwd packages/cli build",
    "typecheck": "bun run --cwd packages/shared build && bun run --cwd packages/react-native-updater typecheck && bun run --cwd packages/worker typecheck && bun run --cwd packages/cli typecheck && bun run --cwd apps/dashboard typecheck",
    "test": "bunx vitest run",
    "lint": "bunx oxlint .",
    "worker:dev": "bunx wrangler dev --config packages/worker/wrangler.toml",
    "worker:deploy": "bunx wrangler deploy --config packages/worker/wrangler.toml",
    "dashboard:build": "bun run --cwd apps/dashboard build",
    "parity:audit": "bun scripts/parity-report.ts",
    "admin:backfill-missing-store-urls": "bun scripts/backfill_missing_store_urls.ts",
    "admin:backfill-plugin-version-ladder": "bun scripts/backfill_plugin_version_ladder.ts",
    "stripe:backfill-ltv-metrics": "bun scripts/backfill_ltv_metrics.ts",
    "stripe:backfill-subscription-end-dates": "bun scripts/backfill_stripe_subscription_end_dates.ts",
    "stripe:backfill-retention-metrics": "bun scripts/backfill_retention_metrics.ts",
    "native:contract": "bunx vitest run packages/react-native-updater/test/native-contract.test.ts",
    "cli": "bun run --cwd packages/cli start"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260611.0",
    "@types/bun": "^1.3.5",
    "@types/node": "^24.10.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "oxlint": "^1.67.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.1.8",
    "wrangler": "^4.54.0"
  }
}
